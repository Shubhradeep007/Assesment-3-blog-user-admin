<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card mt-4">
            <div class="card-header bg-white">
                <h4 class="mb-0">Edit Blog</h4>
            </div>
            <div class="card-body">
                <form action="/blogs/<%= blog._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label">Blog Title</label>
                        <input type="text" class="form-control" id="title" name="title" value="<%= blog.title %>" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="content" class="form-label">Content</label>
                        <textarea class="form-control" id="content" name="content" rows="10" required><%= blog.content %></textarea>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label">Current Image</label>
                        <% if(blog.image) { %>
                            <div class="mb-2">
                                <img src="<%= blog.image %>" alt="Current Image" class="img-thumbnail" style="max-height: 200px;">
                            </div>
                        <% } else { %>
                            <p class="text-muted small">No image uploaded.</p>
                        <% } %>
                        <label for="image" class="form-label">Upload New Image (Optional)</label>
                        <input class="form-control" type="file" id="image" name="image" accept="image/*">
                        <div class="form-text">Uploading a new image will replace the current one. Max size: 5MB.</div>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Update Blog</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
