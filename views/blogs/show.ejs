<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card mb-4">
            <% if(blog.image) { %>
                <img src="<%= blog.image %>" class="card-img-top" alt="Blog Image" style="max-height: 400px; object-fit: cover;">
            <% } %>
            <div class="card-body">
                <h1 class="card-title mb-3"><%= blog.title %></h1>
                
                <div class="d-flex align-items-center mb-4 text-muted">
                    <% if(blog.author.profileImage) { %>
                        <img src="<%= blog.author.profileImage %>" alt="Author" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;">
                    <% } %>
                    <div>
                        <strong><%= blog.author.name %></strong>
                        <br>
                        <small><%= new Date(blog.createdAt).toLocaleDateString() %></small>
                    </div>
                </div>

                <div class="card-text mb-4" style="white-space: pre-wrap;"><%= blog.content %></div>
                
                <div class="d-flex justify-content-between">
                    <a href="/blogs" class="btn btn-outline-secondary">&larr; Back to Blogs</a>
                    
                    <% if(user && (user._id.toString() === blog.author._id.toString() || user.role === 'admin')) { %>
                        <div>
                            <a href="/blogs/edit/<%= blog._id %>" class="btn btn-warning">Edit</a>
                            <form action="/blogs/<%= blog._id %>?_method=DELETE" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this blog?');">Delete</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
